# Copy to .env for local development. Never commit .env.
# On Cloud Run, set these under Variables & Secrets instead (see README → Deploy).

# Gemini on Vertex AI (Agent Platform)
GEMINI_MODEL=gemini-3.8-flash
GOOGLE_CLOUD_LOCATION=global
# GOOGLE_CLOUD_PROJECT=your-project-id   # auto-detected from gcloud if omitted

# National Institute of Korean Language dictionaries
KRDICT_API_KEY=
STDICT_API_KEY=
OPENDICT_API_KEY=

# Naver: NAVER API HUB on Naver Cloud Platform (select 검색 + 검색어 트렌드)
# Use the application's Client ID / Client Secret from 인증 정보.
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
# NAVER_API=legacy   # only for old Developers Center keys issued before 2026-07-31

# Storage: auto | true | false  (false = in-memory word bank)
USE_FIRESTORE=auto
